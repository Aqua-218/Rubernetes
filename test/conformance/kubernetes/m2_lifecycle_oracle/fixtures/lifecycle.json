    "graceful_termination_oracle": {
      "pod": {
        "apiVersion": "v1",
        "kind": "Pod",
        "metadata": {"name": "m2-grace", "namespace": "default", "uid": "m2-grace"},
        "spec": {
          "restartPolicy": "Never",
          "terminationGracePeriodSeconds": 2,
          "containers": [
            {
              "name": "app",
              "image": "registry.k8s.io/e2e-test-images/busybox@sha256:caec39cad3b12c26600baf6e67ba811ac15d28a9288d0ccdfffb4b318992c3bb",
              "command": ["/bin/sh", "-c", "trap 'echo TERM >> /dev/termination-log' TERM; while true; do sleep 1; done"],
              "lifecycle": {"preStop": {"exec": {"command": ["/bin/sh", "-c", "echo preStop >> /dev/termination-log"]}}}
            }
          ]
        }
      },
      "operations": ["exec:preStop", "signal:TERM", "wait:2", "signal:KILL", "observe:events", "observe:phase", "observe:status"],
      "observation": {
        "settle": "the Pod is deleted once the app container is running and ready; the case ends with the last status observed before the Pod object disappears",
        "operations_source": "termination message lines (preStop, TERM) prove hook and signal order; exitCode 137 after the grace period proves KILL",
        "events_source": "ordered distinct event reasons recorded for the Pod after the delete request"
      }
