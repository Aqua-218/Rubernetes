          "containers": [
            {"name": "app", "image": "registry.k8s.io/e2e-test-images/busybox@sha256:caec39cad3b12c26600baf6e67ba811ac15d28a9288d0ccdfffb4b318992c3bb", "command": ["/bin/sh", "-c", "sleep 300"]}
          ]
        }
      },
      "operations": ["create:prepare", "start:prepare", "wait:prepare", "create:sidecar", "start:sidecar", "create:app", "start:app"],
