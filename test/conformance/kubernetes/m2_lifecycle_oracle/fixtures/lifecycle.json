      "operations": ["exit:always_exit_0:0", "exit:on_failure_exit_0:0", "exit:on_failure_exit_1:1", "exit:never_exit_1:1", "observe:restartCount", "observe:phase", "observe:status", "observe:backoff"],
      "observation": {
        "restarting_variants": ["always_exit_0", "on_failure_exit_1"],
        "settle": "restarting variants are observed when restartCount reaches 2 and the container is waiting in CrashLoopBackOff; terminal variants are observed when the phase is Succeeded or Failed",
        "backoff_seconds_source": "seconds between the finishedAt of run N and the startedAt of run N+1 for the first two restarts, rounded to the nearest 10 seconds (kubelet initial CrashLoopBackOff 10s doubling)"
