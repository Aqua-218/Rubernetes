    "startup_liveness_readiness_thresholds": {
      "pod": {
        "apiVersion": "v1",
        "kind": "Pod",
        "metadata": {"name": "m2-probes", "namespace": "default", "uid": "m2-probes"},
        "spec": {
          "restartPolicy": "Always",
          "containers": [
            {
              "name": "app",
              "image": "registry.k8s.io/e2e-test-images/busybox@sha256:caec39cad3b12c26600baf6e67ba811ac15d28a9288d0ccdfffb4b318992c3bb",
              "command": ["/bin/sh", "-c", "sleep 300"],
              "startupProbe": {"exec": {"command": ["/bin/true"]}, "successThreshold": 1, "failureThreshold": 3, "periodSeconds": 1},
              "livenessProbe": {"exec": {"command": ["/bin/false"]}, "failureThreshold": 2, "periodSeconds": 1, "initialDelaySeconds": 10},
              "readinessProbe": {"exec": {"command": ["/bin/true"]}, "successThreshold": 2, "failureThreshold": 1, "periodSeconds": 1}
            }
          ]
        }
      },
      "operations": ["probe:startup:success", "probe:readiness:success", "probe:readiness:success", "probe:liveness:failure", "probe:liveness:failure", "kill:liveness", "restart:app"],
      "observation": {
        "settle": "started=true and ready=true are observed before the first liveness Killing event; the case ends when restartCount reaches 1",
        "liveness_failures_before_kill_source": "count of Unhealthy events whose message starts with 'Liveness probe failed' at the moment the Killing event with message 'Container app failed liveness probe, will be restarted' is first observed"
      }
    },
