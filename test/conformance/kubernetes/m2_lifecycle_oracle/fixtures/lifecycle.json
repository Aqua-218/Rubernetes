            {"name": "sidecar", "image": "registry.k8s.io/e2e-test-images/busybox@sha256:caec39cad3b12c26600baf6e67ba811ac15d28a9288d0ccdfffb4b318992c3bb", "command": ["/bin/sh", "-c", "sleep 300"], "restartPolicy": "Always"}
