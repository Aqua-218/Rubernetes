# Environment for the rubernetes-dashboard service (copy to /etc/rubernetes/dashboard.env).
# Rails needs a secret; generate one with: ruby -rsecurerandom -e 'puts SecureRandom.hex(64)'
SECRET_KEY_BASE=change-me
# Basic-auth password for the whole UI and API (empty = no authentication).
DASHBOARD_PASSWORD=
# Cluster wiring (defaults shown).
RUBERNETES_CLUSTER_ROOT=/srv/rbn-app/linux-amd64-ipv4-native
RUBERNETES_KUBECONFIG=/srv/rbn-app/linux-amd64-ipv4-native/kubeconfig
# Where blocks, the WAL and the label index live.
DASHBOARD_DATA_DIR=/var/lib/rubernetes/dashboard
# Scrape / evaluation cadence and retention.
DASHBOARD_SCRAPE_INTERVAL=15
DASHBOARD_SCRAPE_TIMEOUT=10
DASHBOARD_EVALUATION_INTERVAL=15
DASHBOARD_RETENTION=15d
DASHBOARD_BLOCK_RANGE=2h
# Rules file (Prometheus format) and an Alertmanager-compatible webhook.
DASHBOARD_RULES=/root/Programming/Ruby/2026/apps/dashboard/config/rules.yml
DASHBOARD_ALERT_WEBHOOK=
# Set to 0 to make the UI read-only (no delete/scale/restart).
DASHBOARD_ALLOW_WRITES=1
# Pod/Service scrapes reach Pod IPs directly; never route them through a proxy.
no_proxy=localhost,127.0.0.1,10.0.0.0/8
