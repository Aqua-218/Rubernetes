# Rubernetes service proxy.
#
# The unit runs the daemon in the foreground under systemd supervision and
# restarts it on any exit: every Rubernetes daemon reconciles its durable
# state on startup, so a restart is the recovery path rather than a last
# resort.  Configuration lives in one YAML file per process; the daemon reads
# nothing else from the environment.
[Unit]
Description=Rubernetes service proxy
Documentation=file:///usr/share/rubernetes/deploy/cluster/README.md
After=rubernetes-apiserver.service
Wants=rubernetes-apiserver.service

[Service]
Type=simple
ExecStart=/usr/local/bin/rubernetes-proxy --config /etc/rubernetes/proxy.yml
Restart=always
RestartSec=2
TimeoutStopSec=30
KillSignal=SIGTERM

# A daemon that cannot be restarted is worse than one that restarts often:
# the limits below are deliberately generous so a crash loop is still visible
# in the journal instead of being silently rate limited into a dead unit.
StartLimitIntervalSec=0

# Hardening.  The node agent and the proxy own kernel state and keep the
# capabilities they need; the control plane keeps none.
NoNewPrivileges=no
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW

ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
ReadWritePaths=/var/lib/rubernetes /var/log/rubernetes
StateDirectory=rubernetes
LogsDirectory=rubernetes
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
